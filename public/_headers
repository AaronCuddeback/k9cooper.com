# Cloudflare Pages response headers.
#
# WHY THIS FILE EXISTS
# `headers()` in next.config.ts only works when Next.js is serving the site.
# This site is built with `output: 'export'` and served as static files, so
# Next is not in the request path and that config does nothing at runtime.
# These rules are the live ones. Keep the two in sync: if you change one,
# change the other, or the local dev server and production will disagree.
#
# Cloudflare Pages reads this file from the build output root. It is copied
# there automatically because it lives in /public.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: on
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The generated Open Graph card is written by Next as an extensionless file
# (out/opengraph-image). Cloudflare Pages picks Content-Type from the file
# extension, so without this it is served as a download rather than an image
# and every social share card - Facebook, X, LinkedIn, iMessage, Slack -
# silently falls back to no preview image. Do not remove.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400

# Hashed build assets are immutable - cache them hard.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images and video are replaced by editing the file in /public, which does not
# change the URL, so keep this shorter than the hashed assets above.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
